Program:
  FunctionDeclNode: main
    Params:
    Returns:
      VarDecl: res : INT
    Uses:
      VarDecl: a : INT
      VarDecl: b : INT
    Body:
      Assign: a
        IntLit (10) [INT]
      Assign: b
        BinaryOp (+) [INT]
          Var (a) [INT]
          IntLit (5) [INT]
      If:
        Condition:
          BinaryOp (==) [BOOL]
            Var (a) [INT]
            IntLit (10) [INT]
        ThenBody:
          Assign: b
            BinaryOp (+) [INT]
              Var (b) [INT]
              IntLit (1) [INT]
        ElseBody:
          Assign: b
            IntLit (0) [INT]
      Assign: res
        Var (b) [INT]
